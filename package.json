{
    "name": "@bawolf/inkwell-client",
    "version": "0.0.1",
    "description": "Official Inkwell API client for JavaScript/TypeScript",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "test": "jest --config jest.config.cjs",
        "test:watch": "jest --config jest.config.cjs --watch",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write src/**/*.ts",
        "prepublishOnly": "npm run build && npm run test",
        "smoke": "npm run build && DEBUG=inkwell:client node scripts/smoke.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "inkwell",
        "api",
        "client",
        "typescript",
        "javascript",
        "ai",
        "generative",
        "assets"
    ],
    "author": "Inkwell Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/bawolf/inkwell-client-ts.git"
    },
    "bugs": {
        "url": "https://github.com/bawolf/inkwell-client-ts/issues"
    },
    "homepage": "https://github.com/bawolf/inkwell-client-ts#readme",
    "dependencies": {
        "axios": "^1.6.0",
        "debug": "^4.3.4",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.0.0",
        "@types/debug": "^4.1.12",
        "@types/jest": "^29.0.0",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.0.0",
        "prettier": "^3.0.0",
        "rollup": "^4.0.0",
        "ts-jest": "^29.0.0",
        "tslib": "^2.8.1",
        "typescript": "^5.0.0"
    }
}